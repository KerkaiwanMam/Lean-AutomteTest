# Copy to .env (never commit .env) and fill in per client job.

# Site under test — use the client's staging/preview URL whenever one exists
BASE_URL=https://staging.example.com

# Pages every smoke test visits (comma separated, relative to BASE_URL)
SMOKE_PATHS=/,/login,/pricing

# --- Optional: critical flow + access control (tests skip when empty) ---
LOGIN_PATH=/login
# Test accounts supplied by the client (intake form part C). Never use real customer accounts.
TEST_USER=
TEST_PASSWORD=
# A page only a logged-in user may see; checked after login
AFTER_LOGIN_PATH=/dashboard

# URLs that must be refused when NOT logged in (expect 401/403/404 or a redirect to the login page)
PROTECTED_URLS=/dashboard,/api/me
# URLs that belong to ANOTHER user; TEST_USER must be refused (IDOR check)
FORBIDDEN_URLS=

# Console messages to ignore (regular expression), e.g. a noisy third-party widget
IGNORE_CONSOLE=
